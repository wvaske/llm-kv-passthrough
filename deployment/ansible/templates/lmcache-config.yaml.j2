# LMCache Server Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Host: {{ inventory_hostname }}

instance_id: {{ kvbench_instance_id | default(inventory_hostname) }}

server:
  host: 0.0.0.0
  port: {{ kvbench_port | default(8000) }}
  server_type: {{ kvbench_server_type | default('combined') }}
  model_profile: {{ kvbench_model | default('llama-3.1-8b') }}
  workers: {{ kvbench_workers | default(1) }}
  log_level: {{ kvbench_log_level | default('info') }}

gpu:
  gpu_profile: {{ kvbench_gpu | default('H100_SXM') }}
  efficiency_factor: {{ kvbench_efficiency | default(0.7) }}
  tp_size: {{ kvbench_tp_size | default(1) }}

# ===========================================
# Resource Allocation (Tier 1: CPU Memory)
# ===========================================
resources:
  cpu_memory_gb: {{ kvbench_cpu_memory_gb | default(64.0) }}
  memory_allocation: {{ kvbench_memory_allocation | default('eager') }}
  nvme_storage_gb: {{ kvbench_nvme_storage_gb | default(500.0) }}
  nvme_path: {{ kvbench_nvme_path | default('/var/lib/kvbench/nvme') }}

# ===========================================
# Storage Backend Configuration
# ===========================================
storage:
{% if kvbench_storage | default('memory') == 'memory' %}
  # In-memory storage (Hot cache only)
  backend_type: memory
  max_size_bytes: {{ (kvbench_cpu_memory_gb | default(64.0) | float * 1073741824) | int }}
{% elif kvbench_storage == 'local_disk' %}
  # Local NVMe storage (Tier 2)
  backend_type: local_disk
  local_disk_path: {{ lmcache_local_disk_path | default('/var/lib/kvbench/cache') }}
  local_disk_max_size_gb: {{ lmcache_local_disk_max_gb | default(500.0) }}
  local_disk_shard_depth: {{ lmcache_shard_depth | default(2) }}
  local_disk_shard_width: {{ lmcache_shard_width | default(256) }}
{% elif kvbench_storage == 'redis' %}
  # Redis remote storage (Tier 3)
  backend_type: redis
  redis_url: {{ redis_url | default('redis://localhost:6379') }}
  redis_cluster: {{ redis_cluster | default(false) | lower }}
{% if redis_password is defined %}
  redis_password: {{ redis_password }}
{% endif %}
{% if redis_prefix is defined %}
  redis_prefix: {{ redis_prefix }}
{% endif %}
{% if redis_ttl is defined %}
  redis_ttl: {{ redis_ttl }}
{% endif %}
  redis_max_connections: {{ redis_max_connections | default(100) }}
  redis_socket_timeout: {{ redis_socket_timeout | default(5.0) }}
  redis_socket_connect_timeout: {{ redis_socket_connect_timeout | default(2.0) }}
{% elif kvbench_storage == 'nfs' %}
  # NFS storage (Tier 3)
  backend_type: nfs
  filesystem_path: {{ kvbench_filesystem_path | default('/mnt/nfs/kvbench') }}
{% elif kvbench_storage == 'weka' %}
  # Weka storage (Tier 3)
  backend_type: weka
  filesystem_path: {{ kvbench_filesystem_path | default('/mnt/weka/kvbench') }}
{% if kvbench_weka_client_path is defined %}
  weka_client_path: {{ kvbench_weka_client_path }}
{% endif %}
{% elif kvbench_storage == 's3' %}
  # S3/MinIO storage (Tier 3)
  backend_type: s3
  s3_endpoint: {{ kvbench_s3_endpoint | default('https://s3.amazonaws.com') }}
  s3_bucket: {{ kvbench_s3_bucket }}
{% if kvbench_s3_prefix is defined %}
  s3_prefix: {{ kvbench_s3_prefix }}
{% endif %}
{% if kvbench_s3_region is defined %}
  s3_region: {{ kvbench_s3_region }}
{% endif %}
{% if kvbench_s3_access_key is defined %}
  s3_access_key: {{ kvbench_s3_access_key }}
{% endif %}
{% if kvbench_s3_secret_key is defined %}
  s3_secret_key: {{ kvbench_s3_secret_key }}
{% endif %}
{% elif kvbench_storage == 'mooncake' %}
  # Mooncake storage
  backend_type: mooncake
  mooncake_local_hostname: {{ kvbench_mooncake_hostname | default(ansible_hostname) }}
  mooncake_metadata_server: {{ kvbench_mooncake_metadata_server | default('etcd://localhost:2379') }}
{% endif %}

# ===========================================
# LMCache Connector Configuration
# ===========================================
connector:
  connector_type: lmcache

  # Chunking configuration
  lmcache_chunk_size: {{ kvbench_lmcache_chunk_size | default(256) }}

  # Model identification
  lmcache_model_name: {{ kvbench_lmcache_model_name | default(kvbench_model | default('llama-3.1-8b')) }}

  # Distributed worker configuration
  lmcache_world_size: {{ kvbench_lmcache_world_size | default(1) }}
  lmcache_worker_id: {{ kvbench_lmcache_worker_id | default(0) }}

  # Key format settings
  lmcache_key_format: {{ kvbench_lmcache_key_format | default('lmcache') }}
  lmcache_key_suffix: {{ kvbench_lmcache_key_suffix | default('@kv_bytes') }}

  # Per-token size estimation (bytes)
  lmcache_bytes_per_token: {{ kvbench_lmcache_bytes_per_token | default(512) }}

{% if kvbench_lmcache_remote_url is defined %}
  # Remote LMCache server (optional)
  lmcache_remote_url: {{ kvbench_lmcache_remote_url }}
{% endif %}

{% if kvbench_server_type == 'proxy' %}
# ===========================================
# Distributed Configuration (Proxy Mode)
# ===========================================
distributed:
  prefill_endpoints:
{% for host in groups['prefill'] | default([]) %}
    - http://{{ hostvars[host].ansible_host | default(host) }}:{{ hostvars[host].kvbench_port | default(8000) }}
{% endfor %}
  decode_endpoints:
{% for host in groups['decode'] | default([]) %}
    - http://{{ hostvars[host].ansible_host | default(host) }}:{{ hostvars[host].kvbench_port | default(8000) }}
{% endfor %}
  health_check_interval: {{ kvbench_health_check_interval | default(10.0) }}
  load_balance_strategy: {{ kvbench_load_balance_strategy | default('round_robin') }}
{% endif %}

# ===========================================
# Metrics Configuration
# ===========================================
metrics:
  enabled: {{ kvbench_metrics_enabled | default(true) | lower }}
  prometheus_port: {{ kvbench_prometheus_port | default(9090) }}
  include_histograms: {{ kvbench_include_histograms | default(true) | lower }}
  histogram_buckets:
    - 0.001
    - 0.005
    - 0.01
    - 0.025
    - 0.05
    - 0.1
    - 0.25
    - 0.5
    - 1.0
    - 2.5
    - 5.0
    - 10.0
