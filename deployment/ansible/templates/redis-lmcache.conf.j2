# Redis Configuration for LMCache
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Host: {{ inventory_hostname }}

# ===========================================
# Network Configuration
# ===========================================
bind {{ redis_bind | default('0.0.0.0') }}
port {{ redis_port | default(6379) }}
protected-mode {{ 'yes' if redis_password is defined else 'no' }}
tcp-backlog 511
timeout 0
tcp-keepalive 300

# ===========================================
# Security
# ===========================================
{% if redis_password is defined %}
requirepass {{ redis_password }}
{% endif %}

# ===========================================
# Memory Management
# ===========================================
maxmemory {{ redis_maxmemory | default('8gb') }}
maxmemory-policy {{ redis_maxmemory_policy | default('allkeys-lru') }}
maxmemory-samples 10

# Hash memory optimization for LMCache chunks
hash-max-listpack-entries 512
hash-max-listpack-value 64

# ===========================================
# Persistence
# ===========================================
{% if redis_persistence | default(true) | bool %}
# RDB snapshots
save 900 1
save 300 10
save 60 10000

rdbcompression yes
rdbchecksum yes
dbfilename dump.rdb
dir {{ redis_data_dir | default('/var/lib/redis') }}

# AOF (Append Only File)
appendonly {{ 'yes' if redis_aof | default(true) | bool else 'no' }}
appendfilename "appendonly.aof"
appendfsync everysec
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb
{% else %}
save ""
appendonly no
{% endif %}

# ===========================================
# Replication (if replica)
# ===========================================
{% if redis_master_host is defined %}
replicaof {{ redis_master_host }} {{ redis_master_port | default(6379) }}
{% if redis_master_password is defined %}
masterauth {{ redis_master_password }}
{% endif %}
replica-serve-stale-data yes
replica-read-only yes
repl-diskless-sync no
{% endif %}

# ===========================================
# Cluster Configuration (if cluster mode)
# ===========================================
{% if redis_cluster | default(false) | bool %}
cluster-enabled yes
cluster-config-file nodes-{{ redis_port | default(6379) }}.conf
cluster-node-timeout 15000
cluster-replica-validity-factor 10
{% endif %}

# ===========================================
# Performance Tuning for LMCache
# ===========================================
# Large value optimization (KV cache chunks can be several KB-MB)
client-output-buffer-limit normal 0 0 0
client-output-buffer-limit replica 256mb 64mb 60
client-output-buffer-limit pubsub 32mb 8mb 60

# I/O threads for better throughput
io-threads {{ redis_io_threads | default(4) }}
io-threads-do-reads yes

# Lazy freeing for background memory reclaim
lazyfree-lazy-eviction yes
lazyfree-lazy-expire yes
lazyfree-lazy-server-del yes
replica-lazy-flush yes
lazyfree-lazy-user-del yes

# Connection handling
maxclients {{ redis_maxclients | default(10000) }}

# ===========================================
# Logging
# ===========================================
loglevel {{ redis_loglevel | default('notice') }}
logfile {{ redis_logfile | default('/var/log/redis/redis-server.log') }}

# ===========================================
# Slow Log (for debugging)
# ===========================================
slowlog-log-slower-than 10000
slowlog-max-len 128

# ===========================================
# Latency Monitoring
# ===========================================
latency-monitor-threshold 100
