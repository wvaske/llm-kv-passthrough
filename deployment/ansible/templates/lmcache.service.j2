[Unit]
Description=KV-Bench LMCache Server
Documentation=https://github.com/your-org/kvbench
After=network.target
{% if kvbench_storage | default('memory') == 'redis' %}
Wants=redis.service
After=redis.service
{% endif %}
{% if kvbench_storage | default('memory') == 'nfs' %}
After=remote-fs.target
Requires=remote-fs.target
{% endif %}

[Service]
Type=simple
User={{ kvbench_user }}
Group={{ kvbench_group }}
WorkingDirectory={{ kvbench_home }}

# Environment configuration
Environment="PATH={{ kvbench_home }}/venv/bin:/usr/local/bin:/usr/bin:/bin"
{% if kvbench_storage | default('memory') == 's3' and kvbench_s3_access_key is defined %}
Environment="AWS_ACCESS_KEY_ID={{ kvbench_s3_access_key }}"
Environment="AWS_SECRET_ACCESS_KEY={{ kvbench_s3_secret_key }}"
{% if kvbench_s3_region is defined %}
Environment="AWS_DEFAULT_REGION={{ kvbench_s3_region }}"
{% endif %}
{% endif %}

# LMCache-specific environment overrides
Environment="KVBENCH_CONNECTOR__CONNECTOR_TYPE=lmcache"
Environment="KVBENCH_CONNECTOR__LMCACHE_CHUNK_SIZE={{ kvbench_lmcache_chunk_size | default(256) }}"
Environment="KVBENCH_CONNECTOR__LMCACHE_WORLD_SIZE={{ kvbench_lmcache_world_size | default(1) }}"
Environment="KVBENCH_CONNECTOR__LMCACHE_WORKER_ID={{ kvbench_lmcache_worker_id | default(0) }}"

# Start command
ExecStart={{ kvbench_home }}/venv/bin/kvbench serve \
    --config {{ kvbench_config_dir }}/config.yaml \
    --host 0.0.0.0 \
    --port {{ kvbench_port | default(8000) }}

# Restart configuration
Restart=always
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

# Logging
StandardOutput=append:{{ kvbench_log_dir }}/kvbench.log
StandardError=append:{{ kvbench_log_dir }}/kvbench-error.log

# Resource limits
{% if kvbench_cpu_memory_gb is defined %}
# Memory limit based on configured CPU memory + 20% overhead
MemoryMax={{ ((kvbench_cpu_memory_gb | float * 1.2 * 1073741824) | int) }}
{% endif %}
{% if kvbench_limit_cpu is defined %}
CPUQuota={{ kvbench_limit_cpu }}%
{% endif %}

# File descriptor limits for high concurrency
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{ kvbench_data_dir }} {{ kvbench_log_dir }} {{ kvbench_nvme_path | default('/var/lib/kvbench/nvme') }}
{% if lmcache_local_disk_path is defined %}
ReadWritePaths={{ lmcache_local_disk_path }}
{% endif %}
{% if kvbench_filesystem_path is defined %}
ReadWritePaths={{ kvbench_filesystem_path }}
{% endif %}

# Capabilities
{% if kvbench_enable_capabilities | default(false) | bool %}
AmbientCapabilities=CAP_NET_BIND_SERVICE
{% endif %}

[Install]
WantedBy=multi-user.target
