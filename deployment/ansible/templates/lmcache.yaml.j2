# LMCache Application Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Host: {{ inventory_hostname }}
#
# This file is LMCache's own configuration — it controls all KV cache
# storage: tier sizes, the local disk path (the device under test), and
# the remote backend shared across prefill/decode fleets.
# Reference: https://docs.lmcache.ai/

chunk_size: {{ lmcache_chunk_size | default(256) }}

# Tier 1: CPU memory (hot)
local_cpu: {{ lmcache_local_cpu | default(true) | lower }}
max_local_cpu_size: {{ lmcache_max_local_cpu_size_gb | default(4.0) }}

{% if lmcache_local_disk_path is defined %}
# Tier 2: local disk (warm) — point at the NVMe or filesystem under test
local_disk: "file://{{ lmcache_local_disk_path }}/"
max_local_disk_size: {{ lmcache_max_local_disk_size_gb | default(100.0) }}
{% endif %}

{% if lmcache_remote_url is defined %}
# Tier 3: remote backend (cold/shared) — e.g. redis://host:6379,
# valkey://..., s3://bucket, fs:///mnt/shared, lm://cache-server:65432
remote_url: "{{ lmcache_remote_url }}"
remote_serde: "{{ lmcache_remote_serde | default('naive') }}"
{% endif %}
